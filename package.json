{
	"name": "water-it",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generate-pwa-assets": "pwa-assets-generator && node scripts/copy-pwa-icons.mjs",
		"test:unit": "vitest --project server",
		"test": "vitest run --project server",
		"test:rules": "firebase emulators:exec --only firestore --project demo-water-it \"vitest run --project rules\"",
		"test:all": "pnpm run test && pnpm run test:rules",
		"emulators": "firebase emulators:start --only auth,firestore --project demo-water-it --import .firebase/seed --export-on-exit .firebase/seed"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/rules-unit-testing": "^6.0.0",
		"@inlang/paraglide-js": "^3.2.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vite-pwa/sveltekit": "^2.0.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"firebase-tools": "^15.35.0",
		"globals": "^17.6.0",
		"magicast": "^0.5.5",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.72.0",
		"date-fns": "^4.4.0",
		"firebase": "^13.2.0",
		"valibot": "^1.5.0"
	}
}
